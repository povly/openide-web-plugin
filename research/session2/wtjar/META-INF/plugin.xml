  <depends optional="true" config-file="web-tools-licensing.xml">ru.openide.pro.updater</depends>
  <!-- Content modules of the platform test-runner plugin. Up to 253 these classes
         (SMTestRunnerConnectionUtil, SMTRunnerConsoleProperties, SMTestLocator, …) lived in
         lib/app.jar and were visible to every plugin; since 262 they ship as
         plugins/platform-testRunner-plugin/lib/modules/intellij.platform.smRunner.jar and must be
         requested explicitly. Module dependencies are not transitive, so nothing we <depends> on
         brings them in. Without this block the test run configurations (Jest / Vitest / Playwright /
         TestCafe) and the DAP test console fail with NoClassDefFoundError the first time a test is
         launched — and compiling against a 253 platform does not reveal it. -->
  <dependencies>
    <module name="intellij.platform.smRunner" />
    <module name="intellij.platform.testRunner" />
    <module name="intellij.xml.emmet" />
  </dependencies>
  <extensionPoints>
    <extensionPoint qualifiedName="com.haulmont.webtools.licenseProvider" interface="com.haulmont.webtools.licensing.WebToolsLicenseProvider" dynamic="true" />
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Enables the "Attach" option in the Open Project dialog, exactly as WebStorm does
             (see webstorm-customization.xml). Attached directory is loaded as an extra module. -->
    <projectAttachProcessor implementation="com.intellij.platform.ModuleAttachProcessor" />
    <actionOnSave id="EslintActionOnSave" implementation="com.haulmont.webtools.langservers.eslintls.EslintSaveListener" order="after FormatOnSaveAction" />
    <actionOnSave id="StylelintActionOnSave" implementation="com.haulmont.webtools.langservers.stylelintls.StylelintSaveListener" order="after FormatOnSaveAction" />
    <actionOnSave id="PrettierActionOnSave" implementation="com.haulmont.webtools.langservers.prettierls.PrettierSaveListener" order="after FormatOnSaveAction" />
    <copyPastePostProcessor implementation="com.haulmont.webtools.langservers.prettierls.PrettierCopyPasteProcessor" />
    <copyPastePostProcessor implementation="com.haulmont.webtools.langservers.tls.TSPasteCopyPasteProcessor" />
    <copyPastePostProcessor implementation="com.haulmont.webtools.langservers.angls.AngularPasteCopyPasteProcessor" />
    <!--        <projectService serviceImplementation="com.haulmont.webtools.settings.WebToolsSettings"/>-->
    <projectService serviceImplementation="com.haulmont.webtools.langservers.angls.AngularProjectContext" />
    <projectService serviceImplementation="com.haulmont.webtools.nestjs.NestProjectContext" />
    <projectService serviceImplementation="com.haulmont.webtools.nestjs.NestSchematicsService" />
    <projectService serviceImplementation="com.haulmont.webtools.langservers.angls.AngularSelectorsCache" />
    <projectService serviceImplementation="com.haulmont.webtools.langservers.angls.AngularCopyPasteService" />
    <projectService serviceImplementation="com.haulmont.webtools.langservers.angls.annotations.templates.AngularInlineTemplatesCache" />
    <projectService serviceImplementation="com.haulmont.webtools.testing.TestResultsCache" />
    <projectService serviceImplementation="com.haulmont.webtools.run.debug.JsDebugDapServerService" />
    <projectService serviceImplementation="com.haulmont.webtools.testing.TestBlocksStore" />
    <applicationService serviceImplementation="com.haulmont.webtools.settings.editor.inlayHints.types.typescript.TSInlayPrefsCache" />
    <applicationService serviceImplementation="com.haulmont.webtools.settings.angular.AngularLsVersionService" />
    <applicationService serviceImplementation="com.haulmont.webtools.settings.highlighting.EditorHighlightingPromoService" />
    <applicationService serviceImplementation="com.haulmont.webtools.settings.vue.VueLsVersionService" />
    <projectService serviceImplementation="com.haulmont.webtools.langservers.cssls.CssColorVariablesCache" />
    <projectService serviceImplementation="com.haulmont.webtools.langservers.cssls.CssDocumentColorsCache" />
    <projectService serviceImplementation="com.haulmont.webtools.langservers.cssls.CssColorVariablesUsagesCache" />
    <projectService serviceImplementation="com.haulmont.webtools.langservers.prettierls.codestyle.PrettierConfigCache" />
    <toolWindow id="Playwright" anchor="right" secondary="true" icon="com.haulmont.webtools.WebToolsIcons.PLAYWRIGHT" factoryClass="com.haulmont.webtools.testing.codegen.PlaywrightToolWindowFactory" />
    <toolWindow id="TestCafe" anchor="right" secondary="true" icon="com.haulmont.webtools.WebToolsIcons.TESTCAFE" factoryClass="com.haulmont.webtools.testing.testcafe.TestcafeToolWindowFactory" />
    <highlightingPassFactory implementation="com.haulmont.webtools.langservers.cssls.CSSColorHighlightingPassFactory" />
    <gotoDeclarationHandler implementation="com.haulmont.webtools.langservers.cssmodule.GotoDeclarationHandler" />
    <gotoDeclarationHandler implementation="com.haulmont.webtools.langservers.angls.actions.AngularSelectorGotoDeclarationHandler" />
    <gotoDeclarationHandler implementation="com.haulmont.webtools.langservers.cssls.CssVariableGotoDeclarationHandler" order="first" />
    <typedHandler implementation="com.haulmont.webtools.langservers.cssls.CssTypedHandler" />
    <!-- Enter inside an empty tag in .vue. No XML PSI there, so the platform's XML handler never
             applies; LSP4IJ's handler claims Enter in every TextMate file but only knows brace pairs,
             so it must run after ours. -->
    <enterHandlerDelegate id="VueEnterBetweenTagsHandler" implementation="com.haulmont.webtools.langservers.vuels.VueEnterBetweenTagsHandler" order="first, before LSPEditorImprovementsEnterBetweenBracesHandler" />
    <!-- Puts the plain word back among the selection candidates: LSP4IJ turns the platform word
             selectioner off whenever a server advertises selectionRange, and a server is free to expose
             no range as small as a word — Tailwind's @theme block and Vue interpolations both did. -->
    <extendWordSelectionHandler id="WebFileWordSelectionHandler" implementation="com.haulmont.webtools.langservers.WebFileWordSelectionHandler" order="first" />
    <registryKey defaultValue="true" description="Enable run line marker for package.json" key="com.haulmont.webtools.runLineMarkers" />
    <registryKey defaultValue="false" description="Has license" key="has.license" />
    <registryKey defaultValue="true" description="Enable CSS module goto declaration via custom textDocument/definition/v2" key="com.haulmont.webtools.cssModuleGotoDeclaration" />
    <registryKey defaultValue="true" description="Run/create test configurations from specs" key="com.haulmont.webtools.testing.main" />
    <registryKey defaultValue="true" description="Use SM test runner UI for Jest/Vitest (disable to fall back to terminal console)" key="com.haulmont.webtools.testing.useReporter" />
    <registryKey defaultValue="true" description="Auto-import missing symbols after pasting code in TypeScript/JavaScript files" key="com.haulmont.webtools.ts.pasteAutoImport" />
    <registryKey defaultValue="true" description="Auto-import missing components/directives after pasting into Angular templates" key="com.haulmont.webtools.angular.pasteAutoImport" />
    <registryKey defaultValue="true" description="Enable LSP message logging to files in IDE log directory (lspLogs/)" key="com.haulmont.webtools.lspLog" />
    <registryKey defaultValue="false" description="Offer not-yet-imported SFC components in Vue templates. Costs a project-wide auto-import fetch from tsserver on every tag completion (~36 MB, measured 2-4s); already-imported and globally registered components are unaffected" key="com.haulmont.webtools.vue.templateComponentAutoImport" />
    <codeInsight.codeVisionProvider implementation="com.haulmont.webtools.langservers.vuels.usages.VueComponentUsagesCodeVisionProvider" />
    <highlightingPassFactory implementation="com.haulmont.webtools.testing.SpecTestHighlightingPassFactory" />
