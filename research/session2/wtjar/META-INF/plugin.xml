    <!-- Claims *.css from the bundled "CSS (syntax highlighting only)" AbstractFileType, which
             would otherwise win the extension and keep TextMate away from the file. Highlighting,
             parsing and the rest then come from the platform's TextMate support — see CSSFileType,
             which is why no providers of our own are registered here. -->
    <fileType id="CSSFile" name="CSSFile" implementationClass="com.haulmont.webtools.css.CSSFileType" fieldName="INSTANCE" extensions="css" />
    <fileType id="JSTSFile" name="JavaScript" implementationClass="com.haulmont.webtools.js.JSFileType" fieldName="INSTANCE" extensions="js;mjs;cjs;ts;tsx;jsx" />
    <!-- Extension-less JS tooling configs, which the IDE would otherwise leave as plain text.
             Neither bean declares a file type: a <fileType> whose name is already registered only
             contributes its matchers to it (FileTypeManagerImpl.mergeOrInstantiateFileTypeBean), so
             both types keep belonging to the JSON plugin, which <depends> guarantees is present.

             .babelrc is JSON5 because Babel reads it with the json5 package (@babel/core
             config/files/configuration.js, readConfigJSON5) — comments and trailing commas are legal
             in it and plain JSON would flag both.

             .prettierrc and .stylelintrc are mapped to JSON because that is what they contain in
             practice, and it buys the SchemaStore option schemas. Note that the tools themselves read
             them with a YAML loader (Prettier's loaders table maps the empty extension to loadYaml;
             Stylelint inherits noExt: loadYaml from cosmiconfig), so a config written in YAML block
             style is valid for the tool while the editor reports it as broken JSON. -->
    <fileType name="JSON5" fileNames=".babelrc" />
    <fileType name="JSON" fileNames=".prettierrc;.stylelintrc" />
