<idea-plugin>
  <id>povly.webfrontendmini</id>
  <name>Web Frontend Mini</name>
  <version>1.4.1</version>
  <vendor>povly</vendor>
  <description>TextMate grammars (css/scss/less/vue + html/js/ts) for the OpenIDE web stack. v1.2: proper TextMate bundle layout (info.plist + Syntaxes/) fixes "unknown format" registration. v1.3: explicit TextMateBackedFileType beans claim css and js/mjs/cjs/ts/tsx/jsx (platform's "syntax highlighting only" AbstractFileTypes otherwise keep TextMate away), js/ts grammars patched with fileTypes.</description>
  <idea-version since-build="262"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.textmate</depends>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Claims css from the platform's bundled CSS AbstractFileType; language is resolved
         in the implementation class (textmate with PlainText fallback) — see WfmCssFileType. -->
    <fileType id="WFM_CSS" name="WFM CSS" implementationClass="povly.wfm.WfmCssFileType" fieldName="INSTANCE" extensions="css" />
    <!-- Claims js from the platform's JavaScript AbstractFileType and gives ts/tsx/jsx/mjs/cjs
         a type at all; shiki js/ts grammars declare no fileTypes of their own. -->
    <fileType id="WFM_JSTS" name="WFM JavaScript" implementationClass="povly.wfm.WfmJsTsFileType" fieldName="INSTANCE" extensions="js;mjs;cjs;ts;tsx;jsx" />
    <!-- Claims vue explicitly (was: generic textmate detector type) so it follows the same
         editor-highlighting path as the other web extensions. -->
    <fileType id="WFM_VUE" name="WFM Vue" implementationClass="povly.wfm.WfmVueFileType" fieldName="INSTANCE" extensions="vue" />
    <editorHighlighterProvider filetype="WFM Vue" implementationClass="povly.wfm.WfmEditorHighlighterProvider" />
    <editorHighlighterProvider filetype="WFM JavaScript" implementationClass="povly.wfm.WfmEditorHighlighterProvider" />
    <editorHighlighterProvider filetype="WFM CSS" implementationClass="povly.wfm.WfmEditorHighlighterProvider" />
    <textmate.bundleProvider implementation="povly.wfm.WebFrontendBundleProvider" />
  </extensions>
</idea-plugin>
