<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Indent-on-Enter + comments for the vue template regions (scope text.html.vue also covers
     script/style, but those match the deeper source.js/source.css selectors first, and the
     tag patterns below are text-disjoint from the brace patterns used there).
     increase: line ends with an opening tag — not closing, not comment/doctype/pi, not self-closing
     (negative lookbehind excludes "/>" ); decrease: line starts with a closing tag. -->
<plist version="1.0">
<dict>
  <key>name</key>
  <string>WFM Vue template indentation and comments</string>
  <key>scope</key>
  <string>text.html.vue</string>
  <key>settings</key>
  <dict>
    <key>indentationRules</key>
    <dict>
      <key>increaseIndentPattern</key>
      <string>.*&lt;[^/!&gt;?][^&gt;]*(?&lt;!/)&gt;[ \t]*</string>
      <key>decreaseIndentPattern</key>
      <string>\s*&lt;/[^&gt;]*&gt;[ \t]*</string>
    </dict>
    <key>shellVariables</key>
    <array>
      <dict>
        <key>name</key>
        <string>TM_COMMENT_START</string>
        <key>value</key>
        <string>&lt;!--</string>
      </dict>
      <dict>
        <key>name</key>
        <string>TM_COMMENT_END</string>
        <key>value</key>
        <string>--&gt;</string>
      </dict>
    </array>
  </dict>
</dict>
</plist>
